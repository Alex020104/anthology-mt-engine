#include "common.h"

Texture2D s_scope;
uniform float4 m_hud_params;
uniform float4 shader_param_6; // x: enabled, y: NV generation, z: 1 color thermal / 2 monochrome thermal
float4 eye_direction_lerp;
float4 eye_position_lerp;
float4 fakescope_params1; // power, inner blur, outer blur, brightness
float4 fakescope_params2; // chroma abber, fog attack(aim), fog attack(move), fog max travel
float4 fakescope_params3; // radius, relative fog radius, fog sharpness, scope sway amount

float getparallax(float d)
{
	return clamp(1 - pow(1 / fakescope_params3.x * fakescope_params3.y * d, fakescope_params3.z), 0, 1);
}



float2 clampMagnitude(float2 v, float l)
{
	float len = length(v);
	return len > 0.00001f ? v / len * min(len, l) : 0.0f;
}

float2 scope_aspect_correction(float2 tc)
{
	tc.x = (tc.x - 0.5f) * (screen_res.x / screen_res.y) + 0.5f;
	return tc;
}

float3 apply_scope_nightvision(float3 image, float2 tc)
{
	float generation = shader_param_6.y;
	float3 color = generation > 1.5f ? float3(0.12f, 1.0f, 0.32f) : float3(0.08f, 1.0f, 0.12f);
	float gain = generation > 1.5f ? 2.35f : 1.85f;
	float luminance = dot(image, LUMINANCE_VECTOR);
	float noise = frac(sin(dot(tc, float2(12.9898f, 78.233f)) + timers.x * 17.0f) * 43758.5453f);
	return color * (luminance * gain + noise * 0.025f);
}

float3 apply_scope_thermal(float3 image, float2 tc, float monochrome)
{
	// Lens-local approximation of Heat Vision's blue/green/yellow/red palette.
	float luminance = saturate(dot(image, LUMINANCE_VECTOR) * 1.35f);
	float3 cold = float3(0.0f, 0.10f, 0.35f);
	float3 cool = float3(0.0f, 0.74f, 1.0f);
	float3 warm = float3(1.0f, 0.80f, 0.0f);
	float3 hot = float3(1.0f, 0.20f, 0.0f);
	float3 thermal = luminance < 0.35f
		? lerp(cold, cool, smoothstep(0.0f, 0.35f, luminance))
		: (luminance < 0.70f
			? lerp(cool, warm, smoothstep(0.35f, 0.70f, luminance))
			: lerp(warm, hot, smoothstep(0.70f, 1.0f, luminance)));
	float noise = frac(sin(dot(tc, float2(12.9898f, 78.233f)) + timers.x * 11.0f) * 43758.5453f) * 0.025f;
	thermal += noise;
	if (monochrome > 0.5f)
	{
		float grey = dot(thermal, LUMINANCE_VECTOR);
		thermal = grey.xxx;
	}
	return saturate(thermal);
}

float4 main(p_screen I,  float4 pos2d : SV_POSITION) : SV_Target
{
	if(m_hud_params.x > 0 && fakescope_params3.x > 0)
	{
		float3 image;
		float2 corrected_texturecoords = scope_aspect_correction(I.tc0);
		
		// get velocity
		float2 eye_velocity = clampMagnitude((mul(m_VP, eye_direction_lerp) * fakescope_params2.y) + (mul(m_VP, eye_position_lerp) * fakescope_params2.z), fakescope_params2.w);
		
		// parallax
		float2 parallax_offset = float2(0.5f + eye_velocity.x, 0.5f - eye_velocity.y);
		float distToParallax = distance(corrected_texturecoords, parallax_offset);
		
		// scope offset
		float2 scope_center = float2(0.5f, 0.5f);
		float distToCenter = distance(corrected_texturecoords, scope_center);
		float4 scope = s_scope.Sample(smp_nofilter, saturate(I.tc0 * float2(1, 0.5625f)));
		
		if(step(distToCenter, fakescope_params3.x) == 1 && m_hud_params.x >= 1.0)
		{
			// Keep the zoom around the screen centre. The previous -0.5 offset
			// sampled outside the scene and produced bright circular artefacts.
			float2 scene_tc = saturate((I.tc0 - 0.5f) * fakescope_params1.x + 0.5f);
			float3 half_res_blur = s_blur_2.Sample(smp_base, scene_tc).rgb;
			
			float2 chroma = float2(fakescope_params2.x * distToCenter, 0.0f);
			image.r = s_image.Sample(smp_base, saturate(scene_tc - chroma)).r;
			image.b = s_image.Sample(smp_base, saturate(scene_tc + chroma)).b;
			image.g = s_image.Sample(smp_base, scene_tc).g;

			image = lerp(image, half_res_blur, fakescope_params1.y);
			
			image.rgb *= getparallax(distToParallax);
			if (shader_param_6.x > 0.5f)
			{
				if (shader_param_6.z > 0.5f)
					image = apply_scope_thermal(image, scene_tc, step(1.5f, shader_param_6.z));
				else
					image = apply_scope_nightvision(image, scene_tc);
			}
		}
		else
		{	
			image = s_image.Sample(smp_base, I.tc0).xyz;
			float3 half_res_blur = s_blur_2.Sample(smp_base, I.tc0).rgb;
			image = lerp(image, half_res_blur, m_hud_params.x * fakescope_params1.z) * (1 - (m_hud_params.x * (1 - fakescope_params1.w)));
		}
		
		if(m_hud_params.x >= 1.0)
		{
			image = lerp(image, scope, scope.a);
		}
		
		return float4(image, 1.0);
	}
	else
	{
		return float4(s_image.Sample(smp_base, I.tc0).xyz, 1.0);
	}
} 
