<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <AnthologyFsrSdk>$(MSBuildThisFileDirectory)..\sdk\FSR3</AnthologyFsrSdk>
    <AnthologyDlssSdk>$(MSBuildThisFileDirectory)..\sdk\DLSS</AnthologyDlssSdk>
  </PropertyGroup>
  <ItemDefinitionGroup><ClCompile>
    <AdditionalIncludeDirectories>$(AnthologyFsrSdk)\include;$(AnthologyDlssSdk)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
  </ClCompile></ItemDefinitionGroup>
</Project>
