M_locked = false
local input_down = {}
local input_fields = {"notes_input_box", "notes_picker_input", "stalker_box_find", "trade_quan_input", "fx_quantity", "biz_price"}

local function native_pda_key(key)
    -- Leave close and mouse events to the native PDA window.
    return key == 1 or key == 337 or key == 338
end

function on_before_key_press(key, action, dis, flags)
    local gui = get_active_gui()
    if not gui then
        if M_locked then release_input() end
        return
    end
    if not M_locked then
        if get_console_cmd(1,"g_3d_pda") then
            for _,name in ipairs(input_fields) do
                if gui[name] then gui[name]:CaptureFocus(false) end
            end
        end
        gui:managecontrols(key, action)
        return
    end
    if native_pda_key(key) or dis or not flags or flags.ret_value == false then return end
    if type(key) ~= "number" or key < 0 or key > 512 then return end
    block_input()
    -- Consume the engine event after delivering it once to the focused control.
    flags.ret_value = false
    if input_down[key] ~= nil then return end
    local handled = CUIScriptWnd.OnKeyboard(gui,key,ui_events.WINDOW_KEY_PRESSED) == true
    input_down[key] = {gui=gui,handled=handled}
    if not handled then gui:managecontrols(key,ui_events.WINDOW_KEY_PRESSED) end
end

function on_before_key_release(key, action, dis, flags)
    local down = input_down[key]
    input_down[key] = nil
    local gui = get_active_gui()
    if not gui then
        if M_locked then release_input() end
        return
    end
    if not M_locked or native_pda_key(key) or dis or not flags then return end
    flags.ret_value = false
    if down and down.gui == gui then
        CUIScriptWnd.OnKeyboard(gui,key,ui_events.WINDOW_KEY_RELEASED)
    end
end

function on_before_key_hold(key, action, dis, flags)
    if not M_locked or native_pda_key(key) or dis or not flags then return end
    local gui = get_active_gui()
    if not gui then release_input();return end
    local down = input_down[key]
    -- Let native edit controls manage their normal repeat delay after a real press.
    if not down or down.gui ~= gui or not down.handled then flags.ret_value = false end
end


function on_before_save_input(flags)
	if M_locked and not get_active_gui() then release_input() end
	if M_locked then flags.ret = true end
end

-----------------------------------------
----------------- GUI ------------------
GUI = nil
PDA_GUI = nil

function start_PDAX()
	hide_hud_inventory()
	CreateTimeEvent("delay_pda_var_set", "delay_pda_var_set", 2, function()
			pda_opened = true
			RegisterScriptCallback("actor_on_update",actor_on_update2)
			return true
		end)
	if (not GUI) or (last_3d_state ~= get_console_cmd(1,"g_3d_pda")) then
		GUI = CustomPDAX()
	end
	last_3d_state = get_console_cmd(1,"g_3d_pda")
	if (GUI) and (not GUI:IsShown()) then
		GUI:ResetUpperMenus()
		--GUI:ShowDialog(true)
		return GUI
	end
end

class "CustomPDAX" (CUIScriptWnd)

function CustomPDAX:__init(is_pda_tab) super()
	self.is_pda_tab = is_pda_tab == true
	self:InitControls()
	self:InitCallBacks()
end

function CustomPDAX:InitControls()
	pda_inter_locations.extend(pdax_level_list)
	self:SetWndRect(Frect():set(0, 0, 1024, 768))
	--self:SetAutoDelete(true) --this little bugger caused my game to crash for 6 hours, I commented it just randomly at 23:52
	if not self.is_pda_tab then
		self:AllowMovement(false)
	end

	self.xml = xml

	self.background = xml:InitStatic("pda_background", self)
	if self.is_pda_tab then
		self.background:SetWndPos(vector2():set(0, 105))
	end
	self.hack = xml:InitEditBox("skid_input", self)
	self.frame1 = xml:InitFrame("frame1", self)
	self.frame2 = xml:InitFrame("frame2", self)
	self.border = xml:InitFrame("border", self)
	self.pda_t = {}		-- to store and control multiple main menu buttons by self.cur_tree or loops
	self.cur_tree = 0	-- what menu is currently open

	self.bottom = {}	-- to loop through lower menus


	-------------------------- Main menu --------------------------
	-- main background, main buttons and their arrows, middle containers
	self:BuildMainMenu(xml)

	-- enable/disable menu buttons for load_state
	self:UpdMenuButtons()
    self:RefreshCommerceAccess(true)

	-------------------------- Sub Menus --------------------------
	self:BuildSubMenus()

	--------------------------- Send button ---------------------------
	self.send_btn = xml:Init3tButton("send_btn", self.background)
	self:Register(self.send_btn, "send_btn")
	self.send_btn:Enable(false)


	--------------------------- Money ---------------------------
	self.money = xml:InitTextWnd("money_text", self.background)
	self:UpdMoneyText()

	-------------------------- Active messages --------------------------
	self:BuildActiveMsg(xml)

	--------------------------- Close button ---------------------------
	self.close_btn = xml:Init3tButton("close_btn", self.background)
	self:Register(self.close_btn, "close_btn")
	if self.is_pda_tab then
		self.close_btn:Show(false)
	end


	-------------------------- Bottom menu --------------------------
	self:BuildBottomMenu(xml)

	if self.is_pda_tab then
		self:ApplyPdaTabLayout()
	end

end

function CustomPDAX:InitCallBacks()

	for i = 1, main_menu_btns do
		CustomPDAX["OnClickMainMenu_".. i] = function(self)
			self:OnClickMainMenu(i)
		end
		self:AddCallback("menu_btn_" .. i, ui_events.BUTTON_CLICKED, self["OnClickMainMenu_" .. i], self)
	end

	self:InitRaidCallbacks()
	self:InitFindCallbacks()
	self:InitGamesCallbacks()
	self:InitTradeCallbacks()
	self:InitNotesCallbacks()
	self:InitBanterCallbacks()
	self:InitTaskCallbacks()

	-- bottom
	for i = 1, 8 do
		CustomPDAX["OnClickExec_".. i] = function(self)
			self:OnClickExec(i)
		end
		self:AddCallback("bot_btn_" .. i, ui_events.BUTTON_CLICKED, self["OnClickExec_" .. i], self)
	end

	self:AddCallback("send_btn", ui_events.BUTTON_CLICKED, self.OnClickSend, self)
	self:AddCallback("close_btn", ui_events.BUTTON_CLICKED, self.OnClickClose, self)
	self:AddCallback("cancel_btn", ui_events.BUTTON_CLICKED, self.OnClickCancel, self)

end

-------------------------------------------------------------------------
------------------------------- Beeld Menus ---------------------------
-------------------------------------------------------------------------
function CustomPDAX:BuildMainMenu(xml)
	self.left_cont = xml:InitStatic("left_container", self.background)
	self.business_xml=CScriptXmlInit();self.business_xml:ParseFile("pda_business.xml")
	local labels={"pda_main_menu_raid","pda_main_menu_find","pda_main_menu_games","pda_main_menu_trade",
		"pda_main_menu_notes","pda_banter_main_menu","pda_task_main_menu","pda_main_menu_black_market",
		"pda_fx_title","pda_auc_title","pda_bounty_title","pda_sale_title"}

	for i = 1, main_menu_btns do
		-- Main menu buttons
		self.pda_t[i] = self.pda_t[i] or {}
		self.pda_t[i].btn = self.business_xml:Init3tButton("navigation", self.left_cont)
		self.pda_t[i].btn:TextControl():SetText(gt(labels[i]))
		self.pda_t[i].btn:SetWndPos(vector2():set(0,main_menu_visible_y[i]))
		self.pda_t[i].btn:SetWndSize(vector2():set(130,24))
		if i == 8 then self.pda_t[i].btn:TextControl():SetText(gt("pda_main_menu_black_market")) end
		if i == 9 then self.pda_t[i].btn:TextControl():SetText(gt("pda_fx_title")) end
		if i >= 10 then
			local title=({[10]="pda_auc_title",[11]="pda_bounty_title",[12]="pda_sale_title"})[i]
			self.pda_t[i].btn:TextControl():SetText(gt(title))
		end
		self:Register(self.pda_t[i].btn, "menu_btn_" .. i)

		-- Mid containers
		-- Both commerce tabs share controls, with separate category lists and rules.
		if i >= 10 then
            if i == 10 then
                self.pda_t[i].mid_cont=self.business_xml:InitStatic("panel",self.background)
            else self.pda_t[i].mid_cont=self.pda_t[10].mid_cont end
        elseif i == 9 then
            self.exchange_xml=CScriptXmlInit();self.exchange_xml:ParseFile("pda_exchange.xml")
            self.pda_t[i].mid_cont=self.exchange_xml:InitStatic("panel",self.background)
        else
            self.pda_t[i].mid_cont = i == 8 and self.pda_t[4].mid_cont
                or xml:InitStatic("mid_container_" .. i, self.background)
        end
		self.pda_t[i].mid_cont:Show(false)
	end

	-- Arrow
	self.main_arrow = xml:InitStatic("left_container:arrow_r", self.left_cont)
	self.main_arrow:Show(false)

end

function CustomPDAX:RefreshCommerceAccess(force)
    if not force and time_global()<(self.commerce_access_after or 0) then return end
    self.commerce_access_after=time_global()+500
    local y=0
    for _,index in ipairs(main_menu_order) do
        local allowed=pda_inter_business.tab_unlocked(index)
        local entry=self.pda_t[index]
        entry.btn:Show(allowed)
        if index==8 then
            if not allowed then entry.btn:Enable(false)
            elseif entry.access_allowed==false then self:UpdMenuButtons() end
        elseif index==10 or index==11 then entry.btn:Enable(allowed) end
        entry.access_allowed=allowed
        if allowed then
            main_menu_visible_y[index]=y
            entry.btn:SetWndPos(vector2():set(0,y));y=y+26
        elseif self.cur_tree==index then
            self:ResetUpperMenus();self:ResetLowerMenus()
        end
    end
    if self.cur_tree and self.cur_tree>0 then
        local pos=self.main_arrow:GetWndPos()
        self.main_arrow:SetWndPos(vector2():set(pos.x,main_menu_visible_y[self.cur_tree]))
    end
end

function CustomPDAX:BuildSubMenus()
	self:BuildRaidUpperMenu()
	self:BuildFindUpperMenu()
	if not CUIAddonCompass then self:BuildGamesUpperMenu() end
	self:BuildTradeUpperMenu()
	self:BuildNotesUpperMenu()
	self:BuildBanterUpperMenu()
	self:BuildTaskUpperMenu()
	pda_inter_gui_i_exchange.build(self)
	pda_inter_gui_j_business.build(self)
end

-------------------- active menu ------------------
function CustomPDAX:BuildActiveMsg(xml)
	self.active_cont = xml:InitStatic("active_cont", self.background)

	-- active text
	self.active_text = xml:InitTextWnd("active_cont:active_cont_text", self.active_cont)
	align_element(self, self.active_text, self.active_cont, "c")

	local cur_active_str = gt("pda_cur_active_none")
	for i = 1, #pda_msg_states do
		if pda_msg_states[i].state == 5 then
			cur_active_str = pda_msg_states[i].active_str
			break
		end
	end
	self.active_text:SetText(gt("pda_cur_active") .. "   " .. cur_active_str)

	-- active cancel button
	self.active_cancel_btn = xml:Init3tButton("cancel_btn", self.background)
	self:Register(self.active_cancel_btn, "cancel_btn")

end

-------------------- bottom menu ------------------
function CustomPDAX:BuildBottomMenu(xml)
	local market_xml = CScriptXmlInit()
	market_xml:ParseFile("pda_market.xml")

	self.bot_scrollbar = xml:InitScrollView("bot_scrollbar", self.background)
	-- AttachBottomScroll owns the single attachment to the scroll pad.
	self.bot_cont_main = xml:InitStatic("bot_cont_main", nil)
	self.bot_cont_main:SetAutoDelete(false)

	-- bottom small containers
	for i = 1, 8 do

		self.bottom[i] = self.bottom[i] or {}

		-- character container
		self.bottom[i].big = xml:InitStatic("bot_cont_main:bot_cont_" .. math.min(i,6), self.bot_cont_main)
		self.bottom[i].big:Show(false)
		local cont1 = self.bottom[i].big

		-- icon
		self.bottom[i].icon = xml:InitStatic("bot_cont_main:bot_cont_" .. math.min(i,6) .. ":bot_icon", self.bottom[i].big)
		align_element(self, self.bottom[i].icon, cont1, "c")

		-- descr
		self.bottom[i].descr = xml:InitTextWnd("bot_cont_main:bot_cont_" .. math.min(i,6) .. ":bot_descr", self.bottom[i].big)
		align_element(self, self.bottom[i].descr, cont1, "c", nil, 0)

		-- button
		self.bottom[i].btn = market_xml:Init3tButton("offer_btn", self.bottom[i].big)
		self:Register(self.bottom[i].btn, "bot_btn_" .. i)
		align_element(self, self.bottom[i].btn, cont1, "c")

	end

	self:LayoutBottomCards()
	self:AttachBottomScroll()

end

-------------------------------------------------------------------------
--------------------------------- Reset ---------------------------------
-------------------------------------------------------------------------
function CustomPDAX:SafeSetWndPos(wnd, x, y)
	if not wnd then return end
	pcall(function() wnd:SetWndPos(vector2():set(x, y)) end)
end

function CustomPDAX:SafeSetWndSize(wnd, w, h)
	if not wnd then return end
	pcall(function() wnd:SetWndSize(vector2():set(w, h)) end)
end

function CustomPDAX:CenterTextControl(wnd, w, h)
	if not wnd then return end
	pcall(function()
		local txt = wnd:TextControl()
		txt:SetWndPos(vector2():set(0, 0))
		txt:SetWndSize(vector2():set(w, h))
		txt:SetTextAlignment(1)
		txt:SetVTextAlignment(1)
	end)
end

function CustomPDAX:AttachBottomScroll()
	if not (self.bot_scrollbar and self.bot_cont_main) then return end
	self.bot_cont_main:SetAutoDelete(false)
	if not self.bot_scroll_attached then
		self.bot_scrollbar:AddWindow(self.bot_cont_main, false)
		self.bot_scroll_attached = true
	end
end

function CustomPDAX:LayoutBottomCards()
	if not self.bottom then return end
	local card_w, card_h = 230, 220
	local gap_x, gap_y = 10, 18
	for i = 1, 8 do
		local card = self.bottom[i]
		if card and card.big then
			local col = (i - 1) % 3
			local row = math.floor((i - 1) / 3)
			self:SafeSetWndPos(card.big, col * (card_w + gap_x), row * (card_h + gap_y))
			self:SafeSetWndSize(card.big, card_w, card_h)
			self:SafeSetWndPos(card.icon, 15, 0)
			self:SafeSetWndSize(card.icon, 200, 90)
			self:SafeSetWndPos(card.descr, 0, 98)
			self:SafeSetWndSize(card.descr, card_w, 82)
			self:SafeSetWndPos(card.btn, 15, 185)
			self:SafeSetWndSize(card.btn, 200, 34)
			pcall(function()
				local txt = card.btn:TextControl()
				txt:SetWndPos(vector2():set(0, 0))
				txt:SetWndSize(vector2():set(200, 34))
				txt:SetTextAlignment(1)
				txt:SetVTextAlignment(1)
			end)
		end
	end
end

function CustomPDAX:SetCommerceFooter(cart)
    if not self.money then return end -- Commerce controls are built before the shell.
    for _,wnd in ipairs({self.send_btn,self.active_cancel_btn,self.active_cont,self.bot_scrollbar}) do
        wnd:Show(not cart)
    end
    self:SafeSetWndPos(self.money,174,cart and 590 or 325)
    if self.shell_rule then self:SafeSetWndPos(self.shell_rule,24,cart and 584 or 316) end
    if self.shell_bottom then self.shell_bottom:Show(not cart) end
end

function CustomPDAX:ApplyPdaTabLayout()
    -- Native Anthology PDA glass ends near x=785; 920-unit layouts cross its bezel.
    self:SafeSetWndPos(self.background,0,90)
    self:SafeSetWndSize(self.background,790,630)
    self.frame1:Show(false);self.frame2:Show(false);self.border:Show(false)
    if not self.shell_rule then
        local skin=CScriptXmlInit();skin:ParseFile("pda_cart.xml")
        self.shell_rule=skin:InitStatic("shell_rule",self.background)
        self.shell_bottom=skin:InitStatic("shell_rule",self.background)
        self.shell_divider=skin:InitStatic("shell_divider",self.background)
        self.shell_bottom:SetWndPos(vector2():set(24,400))
    end
    self:SafeSetWndPos(self.left_cont,24,12)
    self:SafeSetWndSize(self.left_cont,134,310)
    for idx,y in ipairs(main_menu_visible_y) do
        local btn=self.pda_t[idx].btn
        self:SafeSetWndPos(btn,0,y);self:SafeSetWndSize(btn,130,24)
        self:CenterTextControl(btn,130,24)
        btn:TextControl():SetFont(GetFontLetterica16Russian())
    end
    self.main_arrow:InitTexture("ui_inGame2_pda_line_vertical")
    self.main_arrow:SetStretchTexture(true)
    self.main_arrow:SetTextureColor(GetARGB(255,220,194,120))
    self:SafeSetWndPos(self.main_arrow,132,0);self:SafeSetWndSize(self.main_arrow,2,24)
    for i=1,#self.pda_t do
        self:SafeSetWndPos(self.pda_t[i].mid_cont,174,12)
        self:SafeSetWndSize(self.pda_t[i].mid_cont,580,300)
    end
    self:SafeSetWndSize(self.money,580,25)
    self.money:SetTextAlignment(1);self.money:SetVTextAlignment(1)
    self:SafeSetWndPos(self.send_btn,486,362);self:SafeSetWndSize(self.send_btn,126,30)
    self:CenterTextControl(self.send_btn,126,30)
    self:SafeSetWndPos(self.active_cancel_btn,628,362);self:SafeSetWndSize(self.active_cancel_btn,126,30)
    self:CenterTextControl(self.active_cancel_btn,126,30)
    self:SafeSetWndPos(self.active_cont,174,355);self:SafeSetWndSize(self.active_cont,300,37)
    self:SafeSetWndPos(self.active_text,0,0);self:SafeSetWndSize(self.active_text,300,37)
    self.active_text:SetTextAlignment(0);self.active_text:SetVTextAlignment(0)
    self:SafeSetWndPos(self.notes_lock_btn,24,335);self:SafeSetWndSize(self.notes_lock_btn,130,48)
    self:CenterTextControl(self.notes_lock_btn,130,48)
    self.notes_lock_btn:TextControl():SetFont(GetFontLetterica16Russian())
    self:SafeSetWndPos(self.bot_scrollbar,24,410);self:SafeSetWndSize(self.bot_scrollbar,730,204)
    self:SafeSetWndPos(self.bot_cont_main,0,0);self:SafeSetWndSize(self.bot_cont_main,714,696)
    self:LayoutBottomCards();self:AttachBottomScroll()
    self:SetCommerceFooter(self.cart_view==true)
end

function CustomPDAX:ResetUpperMenus()
	pr("Resetting upper half")
	self:SetCommerceFooter(false)
	self.cur_tree = 0
	for i = 1, #self.pda_t do

		-- middle containers
		if self.pda_t[i].mid_cont then
			self.pda_t[i].mid_cont:Show(false)
		end

	end

	-- hide arrow
	self.main_arrow:Show(false)

	-- disable "Send" button
	self.send_btn:Enable(false)

	-- update actor money
	self:UpdMoneyText()

	-- Reset All menus
	self:ResetRaidMenu()		-- 1
	self:ResetFindMenu()		-- 2
	if self.games_menu then self:ResetGamesMenu() end	-- 3
	self:ResetTradeMenu()		-- 4
	self:ResetBanterMenu()	-- 6
	self:ResetTaskMenu()		-- 7

end

function CustomPDAX:ResetLowerMenus()
	pr("Resetting lower half")

	for i = 1, #self.bottom do

		-- Hiding all lower menus
		if self.bottom[i] and self.bottom[i].big then
			self.bottom[i].big:Show(false)
			if self.bottom[i].btn then self.bottom[i].btn:Enable(true) end
		end

	end
	if self.bot_scrollbar then
		self.bot_scrollbar:ScrollToBegin()
	end

end

-------------------------------------------------------------------------
----------------------------- On click events ---------------------------
-------------------------------------------------------------------------
function CustomPDAX:OnClickMainMenu(num)
    self:RefreshCommerceAccess(true)
    if not pda_inter_business.tab_unlocked(num) then return end
    if num == 3 and not self.games_menu then self:BuildGamesUpperMenu() end

	-- do nothing if we click on currently opened menu
	if self.cur_tree ~= num then

		-- reset and hide all upper containers, arrow, disable "Send" button
		self:ResetUpperMenus()

		-- set current tree to pressed menu (num)
		self.cur_tree = num
		if num == 4 or num == 8 then self:SetTradeMode(num == 8) end
		if num == 9 then pda_inter_gui_i_exchange.refresh(self) end
		if num >= 10 then pda_inter_gui_j_business.open(self) end

		-- show and repos arrow to clicked menu
		self.main_arrow:Show(true)
		local arrow_pos = self.main_arrow:GetWndPos()
		local arrow_pos_y = main_menu_visible_y[num]
		self.main_arrow:SetWndPos(vector2():set(arrow_pos.x, arrow_pos_y))

		-- show middle container for clicked menu
		self.pda_t[num].mid_cont:Show(true)

	end

end

function CustomPDAX:OnClickSend()
	-- button should not be active if conditions aren't met
	pr(" 'Send' pressed, self.cur_tree = %s, upda state and UpdMenuButtons()", self.cur_tree)

	-- Menu: 1 - launch "pda_inter_x_raid" squads saving/updating
	if self.cur_tree == 1 then
		self:OnClickSendRaid()

	-- Menu: 2 - launch response calculation, price, chances and message appearing
	elseif self.cur_tree == 2 then
		self:OnClickSendFind()

	-- Menu: 4 - store possible traders, pass sec, name, quantity, level and calculate the price
	elseif self.cur_tree == 4 or self.cur_tree == 8 then
		self:OnClickSendTrade()

	-- Menu: 6 - Banter
	elseif self.cur_tree == 6 then
		self:OnClickSendBanter()

	-- Menu: 7 - tasks
	elseif self.cur_tree == 7 then
		self:OnClickSendTask()

	end

	-- reset all upper menus
	self:ResetUpperMenus()

end

function CustomPDAX:OnClickCancel()

	for i = 1, #pda_msg_states do

		-- check what message is active
		if pda_msg_states[i].state == 5 then
			pr("onCancel, message: %s state = 5, setting to = 0, UpdMenuButtons(), clear tables, ResetLowerMenus()", i)
			-- reset state of active message
			pda_msg_states[i].state = 0

			-- update menu buttons state
			self:UpdMenuButtons()

			-- change active text
			self.active_text:SetText(gt("pda_cur_active") .. "    " .. gt("pda_cur_active_none"))

			-- clear Raid tables
			if i == 1 then
				pda_inter_x_raid.clear_raid_tables()
			end

			-- clear Find tables
			if i == 2 then
				pda_inter_x_buyinfo.clear_find_tables()
			end

			-- clear Trade tables
			if i == 4 then
				pda_inter_x_trade.clear_trade_tables()
			end

			-- clear Task tables
			if i == 7 then
				self.selected_task_type = 0
				pda_inter_x_tasks.clear_task_tables()
			end

			-- reset lower menus
			self:ResetLowerMenus()

		end
	end

end

function CustomPDAX:OnClickExec(num)		-- click lower buttons

	for i = 1, #pda_msg_states do

		-- for big active messages
		if pda_msg_states[i].state == 5 then

			-- Menu 1
			if i == 1 then
				self:OnClickExecRaid(num)
			end

			-- Menu 2
			if i == 2 then
				self:OnClickExecFind(num)
			end

			-- Menu 4
			if i == 4 then
				self:OnClickExecTrade(num)
			end

			-- Menu 7
			if i == 7 then
				self:OnClickExecTask(num)
			end

			-- update buttons
			self:UpdMenuButtons()

		end
	end

end

-------------------------------------------------------------------------
-------------------------- On select/input events ------------------------
-------------------------------------------------------------------------
function OnSnakeGridReset()
	-- The hidden branch enabled a synthetic table-growth workload unrelated to
	-- any visible PDA feature. Never arm that workload in Anthology.
	pda_inter_bp = false
end

-------------------------------------------------------------------------
--------------------------------- Update -------------------------------
-------------------------------------------------------------------------
-- disables menus based on other active messages ("pda_msg_states" mainly)
function CustomPDAX:UpdMenuButtons()
	local big_menu_active = false		-- state 5 active
	local small_menu_active = {}			-- collect small menus which are on cooldown (state = 2)

	-- set "big_menu_active" if at least one menu is at "state = 5"
	for i = 1, #pda_msg_states do
		if pda_msg_states[i].state == 5 then
			pr("UpdMenuButtons() %s state = 5, 'big_menu_active' true", i)
			big_menu_active = true
		elseif pda_msg_states[i].state == 2 then
			table.insert(small_menu_active, i)
		end
	end

	for i = 1, #pda_msg_states do
		if self.pda_t[i] and self.pda_t[i].btn then

			-- enable button first
			self.pda_t[i].btn:Enable(true)

			-- check if button's menu has "big_menu = true"
			if pda_msg_states[i].big_menu then
				-- if "big_menu_active" is true then DISABLE
				if big_menu_active then
					pr("UpdMenuButtons() disabling buttons for message: %s", i)
					self.pda_t[i].btn:Enable(false)
				end
			else
			-- disable buttons for small menus that are on cooldown (state = 2)
				for j = 1, #small_menu_active do
					if small_menu_active[j] == i then
						self.pda_t[i].btn:Enable(false)
					end
				end
			end

			-- menu 1 raid (keep disabled if state = 10) resets on pda_inter_x_raid.cancel_active_raid()
			if i == 1 and pda_msg_states[i].state == 10 then
				self.pda_t[i].btn:Enable(false)
			end

			-- menu 7 tasks (keep disabled if max tasks reached) resets on pda_inter_x_tasks.add_note() and pda_inter_x_tasks.remove_tracker_note_idx()
			if i == 7 and #pda_inter_x_tasks.Active_pda_tasks >= pda_max_tasks then
				self.pda_t[i].btn:Enable(false)
			end


		end
	end

end

function CustomPDAX:UpdMoneyText()
	if not (self.money and db and db.actor) then return end
	self.money:SetText(pda_inter_wallet.text() .. " | " .. db.actor:money() .. " RU")
end

----------------- upd/onkey/close ------------------
function CustomPDAX:Update()
	CUIScriptWnd.Update(self)
	if get_active_gui() ~= self then return end
    self:RefreshCommerceAccess()

	-- Trade Send button conditions and tooltip
	self:TradeUpdate()
	pda_inter_gui_i_exchange.update(self)
	pda_inter_gui_j_business.update(self)

	-- Games (slots and snake)
	if self.games_menu then self:GamesUpdate() end
end

function CustomPDAX:managecontrols(key, keyboard_action)
	if get_active_gui() ~= self or self.cur_tree ~= 3 then return end
	if self.snake_launch then
		if not M_locked then
			self:OnClickNotesLock()
		end
		if self.snake_dir ~= "d" and key == DIK_keys.DIK_W then
			self.snake_dir = "u"
		elseif self.snake_dir ~= "r" and key == DIK_keys.DIK_A then
			self.snake_dir = "l"
		elseif self.snake_dir ~= "l" and key == DIK_keys.DIK_D then
			self.snake_dir = "r"
		elseif self.snake_dir ~= "u" and key == DIK_keys.DIK_S then
			self.snake_dir = "d"
		end
	end

			-- sudoku
	if self.games_menu[5].child_menu:IsShown() and (not self.sudoku_win) and key >= 2 and key <= 11 then
		self:OnPressGamesSudoku(key)
	end

			-- rogue
	if self.rogue_launched then
		self:RogueActorAction(key)
		if not M_locked then
			self:OnClickNotesLock()
		end
	end
end

function CustomPDAX:OnKeyboard(key, keyboard_action)
	if self.is_pda_tab then
		return CUIScriptWnd.OnKeyboard(self, key, keyboard_action)
	end
	if get_console_cmd(1,"g_3d_pda") then return end
	local res = CUIScriptWnd.OnKeyboard(self, key, keyboard_action) -- doesn't work in 3D
	if (res == false) then
		if keyboard_action == ui_events.WINDOW_KEY_PRESSED then
			-- snake
			if M_locked then
				self:OnClickNotesLock()
			end
			self:managecontrols(key, keyboard_action)
		end
	end
	return res
end
function CustomPDAX:OnClickClose()
	if self.is_pda_tab then
		self:Show(false)
		return
	end
	pda_opened = false
	self:AllowMovement(true)
	self:Close()
end

function CustomPDAX:Close()
	if self.is_pda_tab then
		self:Show(false)
		return
	end
	if self:IsShown() then
		self:HideDialog()
		self:Show(false)
	end
end

function CustomPDAX:__finalize()
end

----------------- utils ------------------
function invert_array(gui, array)
	if not gui then return end

	local new_ar = {}

	for i = 1, #array do
		for j = 1, #array[i] do
			new_ar[i] = new_ar[i] or {}
			new_ar[i][j] = array[j][i]
		end
	end

	return new_ar
end

function align_element(gui, elem, cont, h, v, text_h, text_v)	-- align_element(elem, cont, "c", "b") is bottom center
	if not gui then return end
	if (not elem) or (not cont) then return end

	local elem_w = elem:GetWidth()
	local cont_w = cont:GetWidth()
	local elem_h = elem:GetHeight()
	local cont_h = cont:GetHeight()

	if h and type(h) == "string" and (elem_w <= cont_w) then
		local horiz_align

		if h == "l" then
			horiz_align = 0
		elseif h == "r" then
			horiz_align = cont_w - elem_w
		elseif h == "c" then
			horiz_align = (cont_w - elem_w) / 2
		end

		if horiz_align then
			local elem_pos = elem:GetWndPos()
			elem:SetWndPos(vector2():set(horiz_align, elem_pos.y))
		end
	end


	if v and type(v) == "string" and (elem_h <= cont_h) then
		local vert_align

		if v == "t" then
			vert_align = 0
		elseif v == "b" then
			vert_align = cont_h - elem_h
		elseif v == "c" then
			vert_align = (cont_h - elem_h) / 2
		end

		if vert_align then
			local elem_pos = elem:GetWndPos()
			elem:SetWndPos(vector2():set(elem_pos.x, vert_align))
		end
	end

	if text_h and type(text_h) == "number" and text_h < 3 then
		elem:SetTextAlignment(text_h)
	end

	if text_v and type(text_v) == "number" and text_h < 3 then
		elem:SetVTextAlignment(text_v)
	end

end

function diff_to_str(difficulty)
	-- pick difficulty
	local diff_t = {
		["very_easy"] = 0.2,
		["easy"] = 0.4,
		["medium"] = 0.6,
		["hard"] = 0.75,
		["very_hard"] = 0.85,
		["deadly"] = 1.0,
	}

	local picked_diff
	local min_val = 1
	for diff, value in pairs(diff_t) do
		if difficulty <= value and value <= min_val then
			min_val = value
			picked_diff = diff
		end
	end

	-- pick color
	local color_t = {
		["very_easy"] = { 0, 255, 0 },
		["easy"] = { 100, 255, 0 },
		["medium"] = { 200, 255, 0 },
		["hard"] = { 255, 210, 0 },
		["very_hard"] = { 255, 110, 0 },
		["deadly"] = { 255, 0, 0 },
	}

	local picked_color = picked_diff and GetARGB(255, color_t[picked_diff][1], color_t[picked_diff][2], color_t[picked_diff][3])

	return picked_diff, picked_color
end

function val_to_clr(val, param, from, to)
	local clr = strformat("%c[%s,%s,%s,%s]", 255, 190, 190, 190)
	if param == "red_to_green" then
		local nval = normalize(val, from, to)
		local rgb = { 0, 0, 0 }

		if nval < 0.5 then
			local nvalhalf = normalize(nval, 0, 0.5)
			rgb[1] = 255
			rgb[2] = nvalhalf * 255
		else
			local nvalhalf = normalize(nval, 1, 0.5)
			rgb[1] = nvalhalf * 255
			rgb[2] = 255
		end
		clr = strformat("%c[%s,%s,%s,%s]", 255, rgb[1], rgb[2], rgb[3])

	elseif param == "relation" then
		local relation_clr = { ["friend"] = { 0, 255, 0 },		["neutral"] = { 255, 255, 0 },		["enemy"] = { 255, 0, 0 } }
		clr = strformat("%c[%s,%s,%s,%s]", 255, relation_clr[val][1], relation_clr[val][2], relation_clr[val][3])
	end

	return clr
end

function t_to_ar_by_val(tab, layer, output)
	local t = dup_table(tab)
	local a = {}

	if layer then
		for k, v in pairs(t) do
			t[k] = v[1]
		end
	end

	if not output then output = "k" end

	for k, v in spairs(t, function(t, a, b) return t[a] < t[b] end) do
		table.insert(a, (output == "k" and k) or (output == "v" and v))
	end

	return a
end

function t_to_ar(t, by)
	local a = {}
	if t and is_not_empty(t) then
		for k, v in pairs(t) do
			table.insert(a, (by == "k" and k) or (by == "v" and v) or k)
		end
	end

	return a
end

local pda_x_t = {}
function upd_pda_inter()
	return
end

function pr(...)
	if not Custom_PDA_debug then return end
	printf(...)
end

-- save only what's really important (not just in this script), otherwise it will be an unfixable mess
function save_state(m_data)
    m_data.pda_msg_states = pda_msg_states
	m_data.pda_notes_t = pda_notes_t
	-- Migrate old saves by dropping the synthetic 65k-entry payload.
	m_data.pda_x_t = nil
end

function load_state(m_data)
	--pda_opened = m_data.pda_opened or false
    pda_msg_states = m_data.pda_msg_states or { { state = 0, big_menu = true }, { state = 0, big_menu = true }, { state = 0, big_menu = false }, { state = 0, big_menu = true }, { state = 0, big_menu = false }, { state = 0, big_menu = false }, { state = 0, big_menu = true } }
	pda_msg_states[4] = { state = 0, big_menu = true }
	pda_msg_states[8] = { state = 0, big_menu = true }

	pda_notes_t = m_data.pda_notes_t or {}
	pda_x_t = {}

end

function actor_on_update()
	if not pda_inter_bp then return end
	upd_pda_inter()
end

function actor_on_update2(actor, info)
	if not M_locked or not get_active_gui() then
		release_input()
		UnregisterScriptCallback("actor_on_update",actor_on_update2)
	end
end

local input_guard_registered = false
function block_input()
    if input_guard_registered then return end
    input_guard_registered = true
    RegisterScriptCallback("actor_on_update", actor_on_update2)
end

function get_active_gui()
	local menu = ActorMenu and ActorMenu.get_pda_menu and ActorMenu.get_pda_menu()
	if PDA_GUI and menu and menu:IsShown() and menu:GetActiveSection() == "eptInteractivePDA" then
		return PDA_GUI
	end
	if GUI and GUI:IsShown() and not GUI.is_pda_tab then return GUI end
end

-- Background replies must not instantiate a window or depend on it existing.
function refresh_ui(method, ...)
	local gui = get_active_gui() or PDA_GUI or GUI
	if gui and gui[method] then gui[method](gui, ...) end
end

function release_input()
	local was_locked = M_locked
	M_locked = false
	input_down = {}
	input_guard_registered = false
	UnregisterScriptCallback("actor_on_update", actor_on_update2)
	RemoveTimeEvent("delay_pda_var_set2", "delay_pda_var_set3")
	if not was_locked then return end
	local m_data = alife_storage_manager.get_state()
	if m_data.dropbind then
		exec_console_cmd("bind drop " .. m_data.dropbind)
		m_data.dropbind = nil
	end
	local gui = PDA_GUI or GUI
	if gui then
		for _, name in ipairs(input_fields) do
			if gui[name] then gui[name]:CaptureFocus(false) end
		end
		gui.notes_lock_btn:TextControl():SetText(gt("pda_notes_lock_btn"))
	end
end

function actor_on_first_update()
	release_input()
	local m_data = alife_storage_manager.get_state()
	if m_data.dropbind then
		exec_console_cmd("bind drop "..m_data.dropbind)
		m_data.dropbind = nil
	end
	--fallback to prevent breaking
	ActorMenu.get_pda_menu():SetActiveSubdialog("eptTasks")
	-- disable buttons that are supposed to be disabled (raid during state 10 and small buttons with cooldown state 2)
	if pda_msg_states[1].state ~= 10 then
	pda_msg_states[1] = { state = 0, big_menu = true }
	end
	pda_msg_states[2] = { state = 0, big_menu = true }
	pda_msg_states[3] = { state = 0, big_menu = false }
	pda_msg_states[4] = { state = 0, big_menu = true }
	pda_msg_states[5] = { state = 0, big_menu = false }
	pda_msg_states[6] = { state = 0, big_menu = false }
	pda_msg_states[8] = { state = 0, big_menu = true }

	-- not to reset cooldown
	if not pda_msg_states[7] then
		pda_msg_states[7] = {}
	end
	pda_msg_states[7].cd = pda_msg_states[7].cd or {}
	pda_msg_states[7].state = 0
	pda_msg_states[7].big_menu = true
	OnSnakeGridReset()

end

function get_pda_ui()
	if not PDA_GUI then
		PDA_GUI = CustomPDAX(true)
	end
	if PDA_GUI then
		PDA_GUI:ResetUpperMenus()
		PDA_GUI:UpdMenuButtons()
		PDA_GUI:UpdMoneyText()
		PDA_GUI:ApplyPdaTabLayout()
	end
	return PDA_GUI
end

function on_option_change()
	pda_max_tasks = pda_inter_mcm.get_config("task_max_tasks")
	Custom_PDA_debug = pda_inter_mcm.get_config("debugx")
end

function collect_config_params(section)
	dik_to_num = keys_ini:collect_section(section)
end

function on_game_start()
	keys_ini.ini:section_for_each(collect_config_params)
	RegisterScriptCallback("save_state", save_state)
	RegisterScriptCallback("load_state", load_state)
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("on_before_key_press", on_before_key_press)
	RegisterScriptCallback("on_before_key_release", on_before_key_release)
	RegisterScriptCallback("on_before_key_hold", on_before_key_hold)
	RegisterScriptCallback("on_before_save_input", on_before_save_input)
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
	RegisterScriptCallback("on_option_change", on_option_change)
end
