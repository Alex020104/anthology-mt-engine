local SWITCH_CENTER = 330
local SWITCH_FACTOR = 0.10

local original_setup_gulag = nil
local wrapper_installed = false

local function restore_assigned_job_vertex(se_obj)
	if not (se_obj and db and db.spawned_vertex_by_id) then
		return
	end

	local smart_id = se_obj.m_smart_terrain_id
	if not (smart_id and smart_id ~= 65535) then
		return
	end

	local simulation = alife()
	local smart = simulation and simulation:object(smart_id)
	local npc_info = smart and smart.npc_info and smart.npc_info[se_obj.id]
	local task = npc_info and npc_info.job and npc_info.job.alife_task
	local level_vertex = task and task:level_vertex_id()
	if level_vertex then
		-- The online binder consumes this after setup_gulag_and_logic_on_spawn.
		-- db.offline_objects remains higher priority and therefore preserves an
		-- exact last position when the original CoP path has one available.
		db.spawned_vertex_by_id[se_obj.id] = level_vertex
	end
end

local function install_smart_spawn_wrapper()
	if wrapper_installed then
		return
	end

	local current = smart_terrain and smart_terrain.setup_gulag_and_logic_on_spawn
	if not current then
		return
	end

	original_setup_gulag = current
	smart_terrain.setup_gulag_and_logic_on_spawn = function(obj, st, se_obj, stype, loaded)
		local result = original_setup_gulag(obj, st, se_obj, stype, loaded)
		restore_assigned_job_vertex(se_obj)
		return result
	end
	wrapper_installed = true
	printf("* [anthology/alife-v77] persistent CoP smart-job placement active")
end

local function apply_alife_profile()
	local simulation = alife()
	if not simulation then
		return
	end

	simulation:set_switch_factor(SWITCH_FACTOR)
	simulation:set_switch_distance(SWITCH_CENTER)
	printf("* [anthology/alife-v77] online ~= 297 m, offline ~= 363 m")
end

function on_game_start()
	install_smart_spawn_wrapper()
	RegisterScriptCallback("actor_on_first_update", apply_alife_profile)
end
