local commands = {
	"lua_parallel_gc 1",
	"lua_parallel_gc_adaptive 1",
	"lua_parallel_gc_budget_us 5000",
	"lua_parallel_gc_call_amount 25",
	"lua_parallel_gc_frame_budget_us 12000",
	"lua_parallel_gc_postload_delay_ms 0",
	"lua_parallel_gc_pause 200",
	"lua_parallel_gc_stepmul 200",
	"lua_parallel_gc_target_budget_us_per_second 200000",
	"lua_parallel_gc_target_calls_per_second 600",
	"lua_parallel_gcstep 76",
}

function on_game_start()
	for i = 1, #commands do
		exec_console_cmd(commands[i])
	end
	printf("* [anthology/v78] rate-normalized GC profile active")
end
