local last_tick = 0
avg_lenght = 0
score = 0
volume = 0

----{pitch,yaw,lenght,lenght priority,indoor detection priority,player's yaw indepentdent} in degree, lenght priority == 0 mean no contribute to lenghts calculation
local ray_dir_configs = {

	{-120,	60,		50,		0.25,1.25},
	{120,	60,		50,		0.25,1.25},
	{25,	35,		65,		1.2,1.5},
	{-25,	35,		65,		1.2,1.5},
	{180,	50,		50,		0,2.1,true},

	{0,		3.5,	90,		2,0.3,true},
	{20, 	8,		80,		2,0.3,true},
	{-20, 	8,		80,		2,0.3,true},
}

local pre_ray_dir_configs = {
	{0,		90,		40,		0,2.75,true},
	{60,	45,		60,		0.75,1.5},
	{-60,	45,		60,		0.75,1.5},
	{0,		20,		75,		2,1},
	{0,		70,		60,		1.25,1.5},

	-- {0,		0,		90,		2,0.3,true},
}

local material_black_list = {
	"water",
	"bush",
	"tree",
}

local underground_levels = {"jupiter_underground", "l03u_agr_underground", "l08u_brainlab", "l13_generators", "labx8", "l12u_sarcofag", "l10u_bunker", "l04u_labx18"}
---------------------MCM
local mcm_settings = env_gunsnd_mcm.mcm_setup

function on_option_change(mcm)
	if not mcm then return end
	for i,v in pairs(mcm_settings) do
		if v[2]~="desc" and v[2]~="line"  then
			mcm_settings[i][1] = ui_mcm.get("indoor_framework/"..i)
		end
	end
	if mcm_settings.ray_dbug[1] then
		RegisterScriptCallback("actor_on_weapon_before_fire",actor_on_weapon_before_fire)
	else
		UnregisterScriptCallback("actor_on_weapon_before_fire",actor_on_weapon_before_fire)
	end
end
------------------------
function print(a,...)
	if mcm_settings.dbug[1] then
		if type(a)=="table" then
			printf("ze table\n%s", utils_data.print_table(a, false, true))
		else
			printf(tostring(a))
		end
	end
end

local sys_param_types = {
    string = 0,
    boolean = 1,
    number = 2
}

function table_find(t,f)
	for i,v in pairs(t) do
		if v == f then
			return i
		end
	end
end

function getAvg(tabl)
	local s = 0
	for i = 1,#tabl do
		s = s+tabl[i]
	end
	return s/#tabl
end

function getSummation(n)
	return n*(n+1)*0.5
end

function toRad(a)
	return a* 0.017453292519943295769236907684886
end

function getActorPos()
	local pos = db.actor:position()
	if IsMoveState("mcCrouch") and IsMoveState("mcAccel") then -- Prone
		pos.y = pos.y + 0.4
	elseif IsMoveState("mcCrouch") then
		pos.y = pos.y + 1.2
	else
		pos.y = pos.y + 1.6
	end
	return vector():set(pos)
end

function haveIndoorSound(sec)
	sec = sec or get_wp_sec()
	if not sec then return false end
	if SYS_GetParam(sys_param_types.boolean, sec, "snd_shoot_indoor") == false then return true end
	if SYS_GetParam(sys_param_types.boolean, sec, "snd_shoot_actor_indoor") == false then return true end
	return false
end

function drop_off_equation(n)
	return clamp(4/(4+(n-1)),0.1,1)
end

function clamp(x, min, max)
  return x < min and min or (x > max and max or x)
end

function tail_volume_equation(n) -- Check Desmos again  :)
	return ((n<1 and n^4) or math.max(7.5/(7.5-(n-1)),0.1))
end

function get_wp_sec(parent)
	local wpn = db.actor:active_item()
	if parent then
		wpn = parent:active_item()
	end
	local sec
	if wpn then
		sec = wpn:section()
	end
	return sec
end

function getSndParamCount(sec,param)
	local paramTabl = {}
	local i = 1
	while SYS_GetParam(0, SYS_GetParam(0, sec, param), "snd_"..i.."_layer") do
		paramTabl[i] = 0
		while SYS_GetParam(0, SYS_GetParam(0, sec, param), "snd_"..i.."_layer"..(paramTabl[i]+1)) do
			paramTabl[i] = paramTabl[i]+1
		end
		i= i+1
	end
	return paramTabl
end

function isBlackListedMaterial(m)
	for i = 1,#material_black_list do
		if string.find(m,material_black_list[i]) then
			return true
		end
	end
	return false
end
--------------------------
local points_table = {}
local lenght_table = {}

local function store_ray_result(index, config, ray_points, ray_lenght)
	local points = points_table[index]
	if points then
		points[1] = ray_points
		points[2] = config[5] or 1
	else
		points_table[index] = {ray_points, config[5] or 1}
	end

	local lenghts = lenght_table[index]
	if lenghts then
		lenghts[1] = ray_lenght
		lenghts[2] = config[4] or 1
	else
		lenght_table[index] = {ray_lenght, config[4] or 1}
	end
end

function actor_on_first_update(wpn,gun)
	last_tick = time_global()
	score = 0
	volume = mcm_settings.volume[1]
	on_option_change(true)
end

function playSound(parent, sec, param, volume)
	if not (sec and param and ini_sys:r_string_ex(sec, param)) then return end
	if ini_sys:r_string_ex(ini_sys:r_string_ex(sec, param), "snd_1_layer") then
		local paramCount = getSndParamCount(sec,param)
		for i = 1,#paramCount do
			local j = math.random(0,paramCount[i])
			if j == 0 then j="" end
			local file = ini_sys:r_string_ex(ini_sys:r_string_ex(sec, param), "snd_"..i.."_layer"..j)
			local sound = xr_sound.get_safe_sound_object(file)
			sound:play_no_feedback(parent, 0, 0, parent:position(), volume, 1)
		end
	elseif string.find(ini_sys:r_string_ex(sec, param),"\\") then
		local sound = xr_sound.get_safe_sound_object(ini_sys:r_string_ex(sec, param))
		sound:play_no_feedback(parent, 0, 0, parent:position(), volume, 1)
	end
end

function fireRay(dir,lenght,origin)
	-- One sweep uses one actor origin. Re-reading actor position for every
	-- direction adds Lua/C++ crossings and can make a moving sweep inconsistent.
	local pos = origin and vector():set(origin) or getActorPos()
	local point = 0
	local total_lenght = 0
	local bounced = 0
	for bounce = 1,mcm_settings.ray_bounce_count[1] do
		local ray_args = {
			ray_range = lenght*(1/bounce)*mcm_settings.ray_lenght_mult[1],
			contact_range = lenght*(1/bounce)*mcm_settings.ray_lenght_mult[1]-0.01,
			flags = (1 + 2),
			ignore_object = db.actor,
			visualize = mcm_settings.ray_dbug[1]
		}
		local ray = demonized_geometry_ray.geometry_ray(ray_args)
		local result = ray:get(vector():set(pos), dir)

		-- This loop checks if the contact surface is a bush, and re-casts the ray just inside it if it is -- By Ujtan
		while result.in_contact and result.result.material_name do
			local name = result.result.material_name
			if not isBlackListedMaterial(name) then
				break -- break out of the loop if contact is not a bush
			end
			ray_args.ray_range = ray_args.ray_range - result.distance
			ray_args.contact_range = ray_args.contact_range - result.distance
			ray = demonized_geometry_ray.geometry_ray(ray_args)
			local new_pos = vector():set(result.position):add(vector():set(dir):mul(0.1))
			result = ray:get(new_pos, dir)
		end
		if result.in_contact then
			point = point+bounce
			total_lenght = total_lenght+result.position:distance_to(pos)*(mcm_settings.ray_bounce_count[1] - bounce + 1)
			bounced = bounced + 1
			local surface_normal = demonized_geometry_ray.get_surface_normal(pos,dir,nil,nil,result)
			if surface_normal then
				dir = vector():reflect(dir, surface_normal)
			else
				break
			end
			pos = result.position
		else
			break
		end
	end
	return point/getSummation(mcm_settings.ray_bounce_count[1]),(bounced == 0 and lenght) or total_lenght/(getSummation(mcm_settings.ray_bounce_count[1])-getSummation(mcm_settings.ray_bounce_count[1]-bounced))
end

function isIndoorPrecondition(dir, origin)
    -------- basicly check if on top of a player have something, if true then it will do more complex raycast below for performance
	local horz = dir:getH() -- Range 0 2pi
	local vert = dir:getP()
    for i, v in pairs(pre_ray_dir_configs) do
		local new_dir = vector():setHP(horz + toRad(v[1]), toRad(v[2]) + vert)
		if v[6] then
			new_dir = vector():setHP(horz + toRad(v[1]), toRad(v[2]))
		end
		local ray_points, ray_lenght = fireRay(new_dir, v[3], origin)
		store_ray_result(i, v, ray_points, ray_lenght)
    end
    local points = 0
	local pointsMultSum = 0
    for i = 1, #pre_ray_dir_configs do
        points = points + points_table[i][1]*points_table[i][2]
		pointsMultSum = pointsMultSum+points_table[i][2]
    end
    return points/pointsMultSum
end

function isIndoorThroughRaycast()
	local pos = getActorPos()
	local dir = device().cam_dir:normalize()
	local horz = dir:getH() -- Range 0 2pi
	local vert = dir:getP()
	local preConScore = isIndoorPrecondition(dir, pos)
	if preConScore<0.25 then return 0,0 end
	for i,v in pairs(ray_dir_configs) do
		local new_dir = vector():setHP(horz + toRad(v[1]), toRad(v[2]) + vert)
		if v[6] then
			new_dir = vector():setHP(horz + toRad(v[1]), toRad(v[2]))
		end
		local ray_points, ray_lenght = fireRay(new_dir:normalize(), v[3], pos)
		store_ray_result(i + #pre_ray_dir_configs, v, ray_points, ray_lenght)
    end
	local points = 0
	local lenghts = 0
	local pointsMultSum = 0
	local lenghtsMultSum = 0
	for i = 1,#points_table do
		points = points+points_table[i][1]*points_table[i][2]
		lenghts = lenghts+lenght_table[i][1]*lenght_table[i][2]*points_table[i][1]
		pointsMultSum = pointsMultSum+points_table[i][2]
		lenghtsMultSum = lenghtsMultSum+lenght_table[i][2]*points_table[i][1]
	end
	return points/pointsMultSum,lenghts/lenghtsMultSum
end

function actor_on_update()
	if not mcm_settings.enable[1] then return end
	if mcm_settings.ray_dbug[1] then return end
	local now = time_global()
	if (now - last_tick)<mcm_settings.tick_interval[1] then return end
	-- tail_enable_for_non is an MCM descriptor table. The old test checked
	-- the table itself, so this intended early-out could never run.
	last_tick = now
	local sec = get_wp_sec()
	if not sec then return end
	if not mcm_settings.tail_enable_for_non[1] and not haveIndoorSound(sec) then return end
	--------------------
	score,avg_lenght = isIndoorThroughRaycast()
	volume = mcm_settings.volume[1]*drop_off_equation(avg_lenght/mcm_settings.ray_drop_off_lenght[1])
	--------------------
end

function actor_on_weapon_before_fire()
	if not mcm_settings.enable[1] then return end
	if (time_global() - last_tick)<mcm_settings.tick_interval[1] then return end
	--------------------
	score,avg_lenght = isIndoorThroughRaycast()
	volume = mcm_settings.volume[1]*drop_off_equation(avg_lenght/mcm_settings.ray_drop_off_lenght[1])
	--------------------
end

function actor_on_weapon_fired()
	local player = db.actor
    if not (player and player:alive()) then return end
	local wpn = db.actor:active_item()
	if not wpn then return end
	local sec = get_wp_sec()
	if not sec then return end
	if (not mcm_settings.tail_enable_for_non[1] and not haveIndoorSound(sec)) then return end
	local volume_transistion = score
	if score>mcm_settings.new_threshold[1] then
		local param = "snd_tail_indoor"
		if wpn:cast_Weapon():IsSilencerAttached() then param = "snd_silncer_tail_indoor" end
		local volume = volume*volume_transistion*mcm_settings.tail_volume[1]*tail_volume_equation(avg_lenght/mcm_settings.tail_length[1])*0.7
		if SYS_GetParam(0, sec, param) then
			playSound(db.actor,sec,param,volume)
		elseif mcm_settings.bak_tail[1] and not wpn:cast_Weapon():IsSilencerAttached() then
			local sound = xr_sound.get_safe_sound_object("weapons\\indoor\\bak\\indoor_simulation_"..math.random(1,4))
			sound:play_no_feedback(player, 0, 0, player:position(), volume, 1)
		end
	end
end

function on_game_start()
	RegisterScriptCallback("on_option_change",on_option_change)
	RegisterScriptCallback("actor_on_first_update",actor_on_first_update)
	RegisterScriptCallback("actor_on_update",actor_on_update)
	RegisterScriptCallback("actor_on_weapon_fired",actor_on_weapon_fired)
	on_option_change(true)
end
