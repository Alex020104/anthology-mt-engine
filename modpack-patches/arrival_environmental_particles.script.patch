@@
 local ray_args = {
 	range = 30
 }
 local inside_pos
+local next_environment_update = 0
+local environment_update_interval = 100
 function actor_on_update()
+	-- Particle systems continue simulating between calls. Cover detection uses
+	-- five ray casts, so running the whole block at render-frame cadence only
+	-- wastes CPU and amplifies frame-time spikes outdoors.
+	local now = time_global()
+	if now < next_environment_update then return end
+	next_environment_update = now + environment_update_interval
+
 	-- Check current weather
