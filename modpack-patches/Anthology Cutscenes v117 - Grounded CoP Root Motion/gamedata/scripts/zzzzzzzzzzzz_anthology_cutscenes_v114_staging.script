		section = "walker@wanderer_elevator_1",
		path = "pas_b400_elevator_wanderer_1_walk",
		required_info = "jup_b218_monolith_hired",
	},
}

local JUP_CAST = {
	{
		story = "jup_b219_actor",
		cover = "jup_b219_actor_smart_cover",
	},
	{
		story = "jup_b219_stalker_tech_id",
		cover = "jup_b219_azot_smart_cover",
	},
	{
		story = "jup_b219_zulus_id",
		section = "walker",
		path = "jup_b219_zulus_walk",
