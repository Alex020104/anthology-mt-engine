-- Anthology Cutscenes v117
-- Keep the v114 LTX protocol, but publish readiness only after the live NPC
-- XFORM has reached and settled at the authored CoP staging point.
-- This module is read-only with respect to NPC placement: it never teleports
-- or directly moves an NPC.

local READY_STABLE_UPDATES = 8
local READY_STABLE_MS = 300
local PRI_SOFT_FALLBACK_MS = 10000
local PAS_SOFT_FALLBACK_MS = 20000
local JUP_SOFT_FALLBACK_MS = 30000

local PRI_XZ_TOLERANCE = 0.30
local PRI_Y_TOLERANCE = 0.50
local PAS_XZ_TOLERANCE = 0.65
local PAS_Y_TOLERANCE = 0.75
local JUP_XZ_TOLERANCE = 0.20
local JUP_Y_TOLERANCE = 0.30
local SETTLE_POSITION_RADIUS = 0.04
local DIRECTION_DOT_MIN = 0.985
local JUP_DIRECTION_DOT_MIN = 0.998
local DETAIL_LOG_INTERVAL_MS = 1000

-- These names intentionally remain v114-compatible because the accepted v114
-- scene LTX files consume them. Only the readiness implementation is replaced.
local PRI_READY_INFO = "anthology_v114_pri_a15_ready"
local PRI_FALLBACK_INFO = "anthology_v114_pri_a15_fallback"
local PAS_READY_INFO = "anthology_v114_pas_b400_ready"
local PAS_FALLBACK_INFO = "anthology_v114_pas_b400_fallback"
-- Keep the v116 info-portion names because the overlaid LTX already clears
-- them at every scene entry and existing saves may contain those identifiers.
local JUP_READY_INFO = "anthology_v116_jup_b219_ready"
local JUP_FALLBACK_INFO = "anthology_v116_jup_b219_fallback"

local callbacks_registered = false

local gates = {
	pri = {
		started_at = nil,
		stable = 0,
		stable_since = nil,
		last_reason = nil,
		last_detail = nil,
		next_detail_log = 0,
		settle_anchors = {},
	},
	pas = {
		started_at = nil,
		stable = 0,
		stable_since = nil,
		last_reason = nil,
		last_detail = nil,
		next_detail_log = 0,
		settle_anchors = {},
	},
	jup = {
		started_at = nil,
		stable = 0,
		stable_since = nil,
		last_reason = nil,
		last_detail = nil,
		next_detail_log = 0,
		settle_anchors = {},
	},
}

local PRI_CAST = {
	{ story = "pri_a15_actor",            cover = "pri_a15_animpoint_actor" },
	{ story = "pri_a15_military_tarasov", cover = "pri_a15_animpoint_military_1" },
	{ story = "pri_a15_military_2",       cover = "pri_a15_animpoint_military_2" },
	{ story = "pri_a15_military_3",       cover = "pri_a15_animpoint_military_3" },
	{ story = "pri_a15_military_4",       cover = "pri_a15_animpoint_military_4" },
	{ story = "pri_a15_vano",             cover = "pri_a15_animpoint_vano",     out_info = "pri_a15_vano_out" },
	{ story = "pri_a15_sokolov_scene",    cover = "pri_a15_animpoint_sokolov",  out_info = "pri_a15_sokolov_out" },
	{ story = "pri_a15_zulus",            cover = "pri_a15_animpoint_zulus",    out_info = "pri_a15_zulus_out" },
	{ story = "pri_a15_wanderer",         cover = "pri_a15_animpoint_wanderer", out_info = "pri_a15_wanderer_out" },
}

local PAS_CAST = {
	{
		story = "pas_b400_zulus",
		section = "walker@zulus_elevator_1",
		path = "pas_b400_elevator_zulus_1_walk",
	},
	{
		story = "pas_b400_vano",
