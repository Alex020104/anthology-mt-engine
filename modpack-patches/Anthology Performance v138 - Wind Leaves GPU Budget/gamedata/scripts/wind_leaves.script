    "nature\\fog_tornado_01",
    -- "nature\\vortex_01",  -- disabled: effect does not suit tornado visuals
}

-- diff_sec comes from level_weathers via global, but we have no direct access.
-- Computed locally: seconds since session start / time_factor.
-- time_factor is cached — changes rarely, engine call is expensive.
local tornado_inited_time  = nil
local tf_cache_timer       = 0
local TF_CACHE_INTERVAL    = 5000  -- refresh time_factor once per 5 real seconds
local function get_diff_sec()
    if not tornado_inited_time then
        tornado_inited_time = game.get_game_time()
    end
    local tg = time_global()
    if tg - tf_cache_timer >= TF_CACHE_INTERVAL then
        tf_cache_timer       = tg
        cached_time_factor   = level.get_time_factor()
    end
    return math.ceil(game.get_game_time():diffSec(tornado_inited_time) / cached_time_factor)
end

local cached_sim    = nil
local cached_gg     = nil
local cached_vertex = -1

local function load_p(path)
    local ok, obj = pcall(particles_object, path)
    if not ok then
        printf("![Wind_Leaves] Failed to load particle: %s", path)
        return nil
    end
    printf("[Wind_Leaves] Loaded OK: %s", path)
    return obj
end

local function init_particles()
    p_flyingleaves    = load_p("nature\\exp_pfx_leaves")
    p_turbulentleaves = load_p("nature\\exp_pfx_leaves_stormy")
    p_torchbugs       = load_p("nature\\exp_pfx_torchbugs")
    p_fogdust         = load_p("graupel\\dust")
    p_nightfog        = load_p("nature\\exp_pfx_fog_00")
    p_heatfog         = load_p("nature\\exp_pfx_fog_01")
    p_fogdust_00      = load_p("nature\\exp_pfx_fogdust_00")
    p_foggdust_00     = load_p("nature\\effects\\exp_pfx_foggdust_00")
    p_fog_dirt        = load_p("nature\\effects\\fog_foggy_dirt")

    -- Summer
    p_leaves_calm  = load_p("nature\\exp_pfx_leaves_calm")
    p_flies        = load_p("nature\\flies_01")
    p_fog_night    = load_p("nature\\exp_pfx_fog_night")
    p_storm_dust   = load_p("nature\\effects\\fog_stormy_dust")
    p_storm_leaves = load_p("nature\\effects\\fog_stormy_leaves_01")

    ug_fogdust_00_1 = load_p("nature\\exp_pfx_fogdust_00")
    ug_fogdust_00_2 = load_p("nature\\exp_pfx_fogdust_00")
    ug_fogdust_00_3 = load_p("nature\\exp_pfx_fogdust_00")
    ug_fog_foggy    = load_p("nature\\fog_foggy_00")

    local raw = {
        p_flyingleaves, p_turbulentleaves, p_torchbugs,
        p_fogdust, p_nightfog, p_heatfog, p_fogdust_00,
        p_foggdust_00, p_fog_dirt,
        p_leaves_calm, p_flies, p_fog_night, p_storm_dust, p_storm_leaves,
        ug_fogdust_00_1, ug_fogdust_00_2, ug_fogdust_00_3, ug_fog_foggy
    }
    all_particles = {}
    local seen = {}
    for _, p in ipairs(raw) do
        if p and not seen[p] then
            all_particles[#all_particles + 1] = p
            seen[p] = true
        end
    end
    printf("[Wind_Leaves] Total unique particles loaded: %s", tostring(#all_particles))

    play_inside = {}
    if p_fogdust     then play_inside[p_fogdust]     = true end
    if p_foggdust_00 then play_inside[p_foggdust_00] = true end
    if p_fog_dirt    then play_inside[p_fog_dirt]    = true end

    play_underground     = {}
    play_underground_arr = {}
    local function add_ug(p)
        if p and not play_underground[p] then
            play_underground[p] = true
            play_underground_arr[#play_underground_arr + 1] = p
        end
    end
    add_ug(ug_fogdust_00_1)
    add_ug(ug_fogdust_00_2)
    add_ug(ug_fogdust_00_3)
    add_ug(ug_fog_foggy)
    add_ug(p_foggdust_00)
    add_ug(p_fog_dirt)
    printf("[Wind_Leaves] play_underground valid particles: %s", tostring(#play_underground_arr))
end

