    w_sky_alt_cold=1, w_partlymisery3=1, w_original_alpha1=1, w_original_alpha2=1,
    w_clarity=1, w_vivid_partly=1, w_vivid_pure=1, w_partly_alt=1,
}
local cycle_cloudy = {
    w_cloudy1=1, w_cloudy2_dark=1, w_cloudy3_dark=1, w_cloudy4=1, w_cloudy5=1, w_cloudy4_dark=1,
    w_cgim_cloudy=1, w_cgim_cloudy_3=1, w_cgim_cloudy_4=1, w_cloudy_misery=1,
    w_cloudy_misery3=1, w_cloudy_mrak=1, w_cloudy_metro=1, w_cloudy_windy=1,
    w_ccgim_cloudy=1, w_nlc_cloudy=1, w_nlc_depressive=1, w_cgim_cloudy_dark=1,
    w_alpha_r3=1, w_paradox_cloudy=1,
}
local cycle_rain   = {
    w_rain1=1, w_rain2=1, w_rain3=1, w_rain4=1, w_rain5=1, w_rain6=1, w_rain7=1,
    w_cloudy3=1, w_rain_sun=1, w_cloudy_rain=1, w_af1_rain=1,
    w_skygod_rain=1, w_paradox_rain=1,
}
local cycle_storm  = {
    w_storm1=1, w_storm2=1, w_storm3=1, w_storm4=1, w_storm5=1, w_storm6=1,
    w_storm_swtc=1, w_cold_storm=1, w_original_alpha3=1,
    w_cgim_storm=1, w_paradox_dark=1,
}
local cycle_foggy  = {
    w_foggy1=1, w_foggy2=1, w_foggy3=1, w_foggy=1,
    w_ccgim_fog=1, w_swtc_tuman=1, w_vivid_tuman=1,
    w_sky_yntar=1, w_deaspir_foggy=1, w_cgim_foggy_sun=1,
}

local logic_timer          = 0
local LOGIC_INTERVAL       = 1000
local cached_level         = ""
local cached_play_leaves   = 0
local level_check_timer    = 0
local LEVEL_CHECK_INTERVAL = 5000

-- Ticks to skip after game load before creating particles_object instances.
-- particles_object() registers the object in ISpatial_DB; if mt_particles is active
-- and the async thread calls UpdateSpatial simultaneously, ISpatial_DB::remove crashes.
-- Waiting 300 actor_on_update ticks (~5-10s depending on framerate) ensures LSS spawn
-- and initial ISpatial population is complete before we touch the spatial database.
local INIT_TICKS_DELAY = 300
local init_ticks       = 0
local particles_inited = false

function on_game_start()
    RegisterScriptCallback("actor_on_first_update", on_game_load)
    RegisterScriptCallback("on_level_changing",     on_game_unload)
    RegisterScriptCallback("actor_on_update",       actor_on_update)
end

function on_game_load()
    -- Reset state but do NOT create particles_object here —
    -- actor_on_first_update fires before LSS finishes spawning objects.
    particles_inited     = false
    init_ticks           = 0
    cached_sim           = alife()
    cached_gg            = cached_sim and game_graph() or nil
    cached_vertex        = -1
    tornado_inited_time  = game.get_game_time()
    tornado_active       = false
    tornado_particle     = nil
    tornado_next_check   = 0
end

function on_game_unload()
    -- Cancel any pending deferred flush — we are stopping everything now.
    -- Use immediate stop: on_level_changing fires after CParticlesAsync is torn down.
    -- Each flush event has a unique key (wl_flush_N) and removes itself via return true,
    -- so RemoveTimeEvent by static key is not needed here.
    flush_scheduled = false
    flush_event_id  = 0
    pending_ops     = {}

    for _, p in ipairs(all_particles) do
        stop_p_immediate(p)
    end
    stop_p_immediate(tornado_particle)

    tornado_particle    = nil
    tornado_active      = false
    tornado_next_check  = 0
    cached_sim          = nil
    cached_gg           = nil
    cached_vertex       = -1
    tornado_inited_time = nil
    cached_weather      = ""
    cached_hour         = -1
    tf_cache_timer      = 0
end

function actor_on_update()
    if not (db.actor and level) then return end

    -- Defer particles_object creation until INIT_TICKS_DELAY ticks after game load.
    -- Each tick is one actor_on_update call; at 60fps this is ~5s, plenty of time
    -- for LSS to finish spawning and ISpatial_DB to stabilise.
    if not particles_inited then
        init_ticks = init_ticks + 1
        if init_ticks < INIT_TICKS_DELAY then return end
        init_particles()
        particles_inited = true
        printf("[Wind_Leaves] Particles initialized after %s ticks", tostring(init_ticks))
    end

    local tg = time_global()

    if tg - level_check_timer >= LEVEL_CHECK_INTERVAL then
        level_check_timer = tg
        if not cached_sim then cached_sim = alife() end
        if cached_sim and not cached_gg then cached_gg = game_graph() end
        if cached_sim and cached_gg then
            local actor_se = cached_sim:actor()
            if actor_se then
                local vid = actor_se.m_game_vertex_id
                if vid ~= cached_vertex then
                    cached_vertex = vid
                    local ok, lid = pcall(function() return cached_gg:vertex(vid):level_id() end)
                    if ok and lid then
                        local actor_level = cached_sim:level_name(lid)
                        if actor_level ~= cached_level then
                            cached_level       = actor_level
                            cached_play_leaves = leaves_maps[actor_level] or 0
                            -- Reset tornado on level change — via queue (still in game thread)
                            stop_p(tornado_particle)
                            tornado_particle   = nil
                            tornado_active     = false
                            tornado_next_check = 0
                            printf("[Wind_Leaves] Level changed: '%s', play_leaves=%s",
                                tostring(cached_level), tostring(cached_play_leaves))
                        end
                    end
                end
            end
        end
    end

    if tg - logic_timer < LOGIC_INTERVAL then return end
    logic_timer = tg

    local weather = level.get_weather and level.get_weather() or ""
    if not weather then weather = "" end

    local is_inside       = GetEvent("current_safe_cover") == true
    local ug_event        = GetEvent("underground") == true
    local ug_map_fallback = cached_level ~= "" and leaves_maps[cached_level] == 0
    local is_underground  = ug_event or ug_map_fallback
    local is_storm        = cycle_storm[weather] == 1

    -- Update tornado (surface only, not indoors)
    if not is_underground and not is_inside and cached_level ~= "" then
        update_tornado(is_storm, cached_level)
    end

    local hour = math.floor(level.get_time_hours and level.get_time_hours() or 0)

    -- Skip active{} rebuild if weather, hour and position have not changed
    local weather_changed = weather ~= cached_weather
    local hour_changed    = hour ~= cached_hour
    if weather_changed then cached_weather = weather end
    if hour_changed    then cached_hour    = hour    end

    local pos  = db.actor:position()

    local pos_moved = pos:distance_to_sqr(last_pos) > MOVE_THRESHOLD_SQR
    local need_move = pos_moved and (tg - move_timer >= MOVE_INTERVAL)

    if need_move then
        move_timer = tg
        last_pos:set(pos.x, pos.y, pos.z)
    end

    if not weather_changed and not hour_changed and not need_move then return end

    snowfall(weather, is_inside, is_underground, cached_play_leaves, hour, pos, need_move)
end

local function stop_all_except(except, pos, need_move)
    for _, p in ipairs(all_particles) do
        if except[p] then
            play_or_move(p, pos, need_move)
        else
            stop_p(p)
        end
    end
end

function snowfall(weather, is_inside, is_underground, play_leaves, hour, pos, need_move)
    if is_underground then
        for _, p in ipairs(play_underground_arr) do
            play_or_move(p, pos, need_move)
        end
        for _, p in ipairs(all_particles) do
            if not play_underground[p] then stop_p(p) end
        end
        return
    end

    if is_inside then
        stop_all_except(play_inside, pos, need_move)
        return
    end

    local active = {}

    -- Dead Zone: constant atmospheric fog outdoors
    if p_fogdust_00 then active[p_fogdust_00] = true end

    -- Summer: night fog 01-03 (dedicated preset if available, fallback otherwise)
    if hour >= NIGHT_FOG_START and hour < NIGHT_FOG_END then
        if p_fog_night then
            active[p_fog_night] = true
        elseif p_nightfog then
            active[p_nightfog] = true
        end
    end

    if cycle_clear[weather] or cycle_partly[weather] or cycle_cloudy[weather] then
        -- Fireflies evening/night (18:00 - 05:00)
        if (hour >= TORCHBUGS_EVENING_START or hour < TORCHBUGS_MORNING_END) and p_torchbugs then
            active[p_torchbugs] = true
        end
        -- Calm daytime leaves (10:00 - 19:00)
        if hour >= CALM_LEAVES_START and hour < CALM_LEAVES_END then
            if play_leaves == 1 and p_leaves_calm then active[p_leaves_calm] = true end
        end
        -- Evening leaves (18:00 - 21:00)
        if hour >= EVENING_LEAVES_START and hour < EVENING_LEAVES_END then
            if play_leaves == 1 and p_flyingleaves then active[p_flyingleaves] = true end
        end
        -- Midges daytime (9:00 - 20:00), swamp maps only
        if hour >= FLIES_START and hour < FLIES_END and p_flies then
            if swamp_maps[cached_level] then
                active[p_flies] = true
            end
        end

    elseif cycle_foggy[weather] then
        if play_leaves == 1 and p_flyingleaves then active[p_flyingleaves] = true end

    elseif cycle_rain[weather] then
        if p_fogdust then active[p_fogdust] = true end
        if play_leaves == 1 and p_flyingleaves then active[p_flyingleaves] = true end

    elseif cycle_storm[weather] then
        -- Dust storm + heat haze
        if p_fogdust      then active[p_fogdust]      = true end
        if p_heatfog      then active[p_heatfog]      = true end
        -- Additional storm dust and leaves
        if p_storm_dust   then active[p_storm_dust]   = true end
        if play_leaves == 1 then
            if p_storm_leaves    then active[p_storm_leaves]    = true end
            if p_flyingleaves    then active[p_flyingleaves]    = true end
            if p_turbulentleaves then active[p_turbulentleaves] = true end
        end
    end

    for _, p in ipairs(all_particles) do
        if active[p] then
            play_or_move(p, pos, need_move)
        else
            stop_p(p)
        end
    end
end
