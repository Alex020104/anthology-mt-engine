local function inside_boundaries(level_name, x, y)
    local vert = map_boundaries[level_name]
    if not vert then return false end
    local inside = false
    local j = #vert
    for i = 1, #vert do
        if (vert[i][2] < y and vert[j][2] >= y or vert[j][2] < y and vert[i][2] >= y) then
            if (vert[i][1] + (y - vert[i][2]) / (vert[j][2] - vert[i][2]) * (vert[j][1] - vert[i][1]) < x) then
                inside = not inside
            end
        end
        j = i
    end
    return inside
end

--==============================================================================================
-- mt_particles safe queue
-- All particles_object mutations (stop/play_at_pos/move_to) are collected into
-- pending_ops during actor_on_update / update_tornado, then flushed once via
-- CreateTimeEvent(delay=1) which fires in the game thread — safely outside
-- CParticlesAsync. This eliminates the ISpatial_DB::remove race condition.
--==============================================================================================

local pending_ops     = {}  -- {op, p, pos} — accumulated this tick
local flush_scheduled = false
local flush_event_id  = 0   -- unique suffix per CreateTimeEvent call

local function flush_pending()
    flush_scheduled = false
    local ops = pending_ops
    pending_ops = {}
    for i = 1, #ops do
        local op = ops[i]
        local p  = op.p
        if p then
            local ok, err
            if op.op == "stop" then
                ok, err = pcall(function() if p:playing() then p:stop() end end)
            elseif op.op == "play" then
                ok, err = pcall(function() if not p:playing() then p:play_at_pos(op.pos) end end)
            elseif op.op == "move" then
                ok, err = pcall(function() if p:playing() then p:move_to(op.pos, zero_vec) end end)
            end
            if not ok then
                printf("![Wind_Leaves] flush_pending error op=%s: %s", tostring(op.op), tostring(err))
            end
        end
    end
    return true  -- remove the time event
end

local function schedule_flush()
    if flush_scheduled then return end
    flush_scheduled = true
    flush_event_id  = flush_event_id + 1
    CreateTimeEvent("wl_mt", "wl_flush_" .. flush_event_id, 1, flush_pending)
end

-- Enqueue stop — called instead of p:stop() directly
local function stop_p(p)
    if p and p:playing() then
        pending_ops[#pending_ops + 1] = {op="stop", p=p}
        schedule_flush()
    end
end

-- Enqueue play or move — called instead of p:play_at_pos() / p:move_to() directly
local function play_or_move(p, pos, need_move)
    if not p then return end
    if p:playing() then
        if need_move then
            pending_ops[#pending_ops + 1] = {op="move", p=p, pos=pos}
            schedule_flush()
        end
    else
        pending_ops[#pending_ops + 1] = {op="play", p=p, pos=pos}
        schedule_flush()
    end
end

-- Immediate stop used only in on_game_unload / level change —
-- at that point CParticlesAsync is already shut down by the engine.
local function stop_p_immediate(p)
    if p and p:playing() then p:stop() end
end

--==============================================================================================

-- Attempt to spawn a tornado away from the actor
local function try_spawn_tornado(actor_pos, level_name)
    if tornado_active then return end
    if math.random() > TORNADO_PROB then return end

    -- Pick a random angle and distance
    local angle = math.rad(math.random(0, 359))
    local dist  = tornado_distance + math.random(0, 150)
    local tx    = actor_pos.x + math.sin(angle) * dist
    local tz    = actor_pos.z + math.cos(angle) * dist

    if not inside_boundaries(level_name, tx, tz) then
        printf("[Wind_Leaves] Tornado: position outside boundaries, skip")
        return
    end

    local pfx_path = tornado_pfx_list[math.random(#tornado_pfx_list)]
    local ok, p = pcall(particles_object, pfx_path)
    if not ok or not p then
        printf("![Wind_Leaves] Tornado: failed to create particle %s", pfx_path)
        return
    end

    local ty  = db.actor:position().y  -- use actor height as terrain level
    local pos = tornado_vec:set(tx, ty, tz)

    -- play_at_pos via queue — safe with mt_particles
    pending_ops[#pending_ops + 1] = {op="play", p=p, pos=pos}
    schedule_flush()

    tornado_particle = p
    tornado_active   = true
    tornado_born_at  = get_diff_sec()
    printf("[Wind_Leaves] Tornado spawned: %s at dist=%.0f angle=%.0f", pfx_path, dist, math.deg(angle))
end

local function update_tornado(is_storm, level_name)
    local dsec = get_diff_sec()

    -- Stop tornado if lifetime expired
    if tornado_active then
        if dsec - tornado_born_at >= TORNADO_LIFETIME then
            -- stop via queue — safe with mt_particles
            stop_p(tornado_particle)
            tornado_particle = nil
            tornado_active   = false
            tornado_next_check = dsec + math.random(TORNADO_MIN_INTERVAL, TORNADO_MAX_INTERVAL)
            printf("[Wind_Leaves] Tornado: lifetime expired")
        end
        return  -- still active — do nothing
    end

    -- Not a storm — reset timer and exit
    if not is_storm then
        tornado_next_check = 0
        return
    end

    -- First check on storm entry
    if tornado_next_check == 0 then
        tornado_next_check = dsec + math.random(TORNADO_MIN_INTERVAL, TORNADO_MAX_INTERVAL)
        return
    end

    -- Time to check
    if dsec >= tornado_next_check and db.actor then
        try_spawn_tornado(db.actor:position(), level_name)
        -- Next interval is set on stop (if spawn succeeded), or immediately if not
        if not tornado_active then
            tornado_next_check = dsec + math.random(TORNADO_MIN_INTERVAL, TORNADO_MAX_INTERVAL)
        end
    end
end

