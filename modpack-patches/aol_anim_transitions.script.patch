--- a/gamedata/scripts/aol_anim_transitions.script
+++ b/gamedata/scripts/aol_anim_transitions.script
@@
-ini_items:section_for_each(itr)
+-- Anthology MT exposes a suffix-filtered iterator so the engine can skip the
+-- thousands of merged system.ltx sections that this module never uses. Keep
+-- the original iterator as a compatibility fallback for other executables.
+if ini_items.section_for_each_suffix then
+    ini_items:section_for_each_suffix("_hud", itr)
+else
+    ini_items:section_for_each(itr)
+end
